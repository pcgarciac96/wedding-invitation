---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Panel de RSVPs";
---

<BaseLayout title={pageTitle}>

<section
  class="min-h-screen w-full bg-[#F5EBDA] px-4 py-8 text-[#5b4638]"
  style="--cream:#FBF4E8; --sepia:#8B6B5E; --accent:#D8C5A8;"
>
  <div class="mx-auto w-full max-w-5xl">
    <header class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-2xl sm:text-3xl font-semibold text-[#5b4638]">
          {pageTitle}
        </h1>
        <p class="text-sm text-[#7a6657]">
          Vista rápida de invitados confirmados y no confirmados.
        </p>
      </div>

      <!-- Filtros -->
      <div
        id="filters"
        class="mt-3 inline-flex gap-2 rounded-xl border border-[color:var(--accent)]/60 bg-[#FBF4E8]/80 p-1"
      >
        <button
          type="button"
          class="filter-btn rounded-lg px-3 py-1 text-xs sm:text-sm font-semibold bg-white shadow-sm"
          data-filter="all"
          aria-pressed="true"
        >
          Todos
        </button>
        <button
          type="button"
          class="filter-btn rounded-lg px-3 py-1 text-xs sm:text-sm font-semibold hover:bg-white/80"
          data-filter="yes"
          aria-pressed="false"
        >
          Confirmados
        </button>
        <button
          type="button"
          class="filter-btn rounded-lg px-3 py-1 text-xs sm:text-sm font-semibold hover:bg-white/80"
          data-filter="no"
          aria-pressed="false"
        >
          No confirmados
        </button>
      </div>
    </header>

    <!-- Resumen -->
    <div
      class="mb-6 grid gap-4 sm:grid-cols-3 text-center text-sm sm:text-base"
      id="summary"
    >
      <div class="rounded-2xl bg-white/80 px-4 py-3 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-[#8B6B5E]">Total registros</p>
        <p id="sum-total" class="mt-1 text-2xl font-semibold text-[#5b4638]">—</p>
      </div>
      <div class="rounded-2xl bg-[#DCFCE7] px-4 py-3 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-emerald-900">Confirmados</p>
        <p id="sum-yes" class="mt-1 text-2xl font-semibold text-emerald-900">—</p>
      </div>
      <div class="rounded-2xl bg-[#FEE2E2] px-4 py-3 shadow-sm">
        <p class="text-xs uppercase tracking-wide text-rose-900">No confirmados</p>
        <p id="sum-no" class="mt-1 text-2xl font-semibold text-rose-900">—</p>
      </div>
    </div>

    <!-- Estado de carga / error -->
    <div id="rsvp-loading" class="mb-4 text-sm text-[#7a6657]">
      Cargando confirmaciones...
    </div>
    <div id="rsvp-error" class="mb-4 hidden rounded-xl bg-rose-100 px-4 py-3 text-sm text-rose-900">
      Ocurrió un error cargando los datos. Intenta de nuevo más tarde.
    </div>

    <!-- Tabla -->
    <div class="overflow-x-auto rounded-2xl bg-white/90 p-4 shadow-sm">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-[#E3D5C5] text-xs uppercase text-[#7a6657]">
          <tr>
            <th class="px-3 py-2">Invitación</th>
            <th class="px-3 py-2">Invitado</th>
            <th class="px-3 py-2">Estado</th>
            <th class="px-3 py-2 hidden sm:table-cell">Nota</th>
            <th class="px-3 py-2 hidden sm:table-cell">Fecha</th>
          </tr>
        </thead>
        <tbody id="rsvp-table-body" class="divide-y divide-[#F1E4D6] text-[#5b4638]">
          <!-- filas generadas por JS -->
        </tbody>
      </table>

      <p
        id="rsvp-empty"
        class="mt-4 hidden text-center text-sm text-[#7a6657]"
      >
        No hay registros todavía.
      </p>
    </div>
  </div>
</section>
</BaseLayout>
<script type="module">
  import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

  // 💾 Config Supabase (mismas que usaste en la invitación)
  const SUPABASE_URL = "https://dxeqhovymralzfnqrjjg.supabase.co";
  const SUPABASE_ANON_KEY =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR4ZXFob3Z5bXJhbHpmbnFyampnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2MzMwODQ0NiwiZXhwIjoyMDc4ODg0NDQ2fQ._riEe0g_ShV8Z4STHUbjBa_NwviLWkONz1VxUQyKz2I";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const $ = (id) => document.getElementById(id);

  const elLoading = $("rsvp-loading");
  const elError = $("rsvp-error");
  const elEmpty = $("rsvp-empty");
  const tbody = $("rsvp-table-body");

  const sumTotal = $("sum-total");
  const sumYes = $("sum-yes");
  const sumNo = $("sum-no");

  const filterBtns = document.querySelectorAll(".filter-btn");

  let allRows = [];
  let currentFilter = "all";

  function setLoading(state) {
    if (!elLoading) return;
    elLoading.textContent = state ? "Cargando confirmaciones..." : "";
  }

  function setError(state) {
    if (!elError) return;
    elError.classList.toggle("hidden", !state);
  }

  function formatDate(value) {
    if (!value) return "";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return String(value);
    return d.toLocaleString("es-CO", {
      dateStyle: "short",
      timeStyle: "short",
    });
  }

  function renderSummary(rows) {
    const total = rows.length;
    const yes = rows.filter((r) => r.attending).length;
    const no = total - yes;

    if (sumTotal) sumTotal.textContent = String(total);
    if (sumYes) sumYes.textContent = String(yes);
    if (sumNo) sumNo.textContent = String(no);
  }

  // 🔁 QUITAR DUPLICADOS (por invite_id + guest_name) y dejar el más reciente
  // Asumimos que el array viene ordenado por created_at DESC (el más nuevo primero)
  function dedupeByInviteAndGuest(rows) {
    if (!Array.isArray(rows)) return [];
    const seen = new Set();
    const result = [];

    for (const row of rows) {
      const key = `${row.invite_id ?? ""}::${row.guest_name ?? ""}`;
      if (seen.has(key)) continue; // ya tenemos uno más reciente
      seen.add(key);
      result.push(row);
    }

    return result;
  }

  function renderTable() {
    if (!tbody) return;

    let rows = allRows;
    if (currentFilter === "yes") {
      rows = rows.filter((r) => r.attending);
    } else if (currentFilter === "no") {
      rows = rows.filter((r) => !r.attending);
    }

    tbody.innerHTML = "";

    if (rows.length === 0) {
      if (elEmpty) elEmpty.classList.remove("hidden");
      return;
    } else {
      if (elEmpty) elEmpty.classList.add("hidden");
    }

    rows.forEach((row) => {
      const tr = document.createElement("tr");
      tr.className = "align-top";

      const statusLabel = row.attending ? "Asiste" : "No asiste";
      const statusColor = row.attending
        ? "bg-emerald-100 text-emerald-800"
        : "bg-rose-100 text-rose-800";

      tr.innerHTML = `
        <td class="px-3 py-2 align-top text-xs sm:text-sm">
          <div class="font-mono text-[11px] uppercase tracking-wide text-[#8B6B5E]">
            ${row.invite_id || "—"}
          </div>
          <div class="text-[11px] text-[#a58a73]">
            Grupo: ${row.group_id || "—"}
          </div>
        </td>
        <td class="px-3 py-2 align-top text-xs sm:text-sm">
          ${row.guest_name || "Invitado/a"}
        </td>
        <td class="px-3 py-2 align-top">
          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${statusColor}">
            ${statusLabel}
          </span>
        </td>
        <td class="px-3 py-2 align-top hidden sm:table-cell text-xs sm:text-sm">
          ${row.notes ? row.notes : "<span class='text-[#b69a84]'>—</span>"}
        </td>
        <td class="px-3 py-2 align-top hidden sm:table-cell text-xs sm:text-sm text-[#7a6657]">
          ${formatDate(row.created_at || row.inserted_at)}
        </td>
      `;

      tbody.appendChild(tr);
    });

    // resumen siempre sobre el total de registros (ya deduplicados)
    renderSummary(allRows);
  }

  async function loadRsvps() {
    setLoading(true);
    setError(false);

    try {
      // Ajusta 'created_at' por el nombre real de tu columna de fecha si es distinto
      const { data, error } = await supabase
        .from("rsvps")
        .select("*")
        .order("created_at", { ascending: false });

      if (error) throw error;

      const raw = data || [];

      // 👇 aquí limpiamos duplicados y nos quedamos con el más nuevo
      allRows = dedupeByInviteAndGuest(raw);

      renderTable();
    } catch (err) {
      console.error("[admin-rsvps] error cargando RSVPs", err);
      setError(true);
    } finally {
      setLoading(false);
    }
  }

  // Manejo de filtros
  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter") || "all";
      currentFilter = filter;

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-pressed", active ? "true" : "false");
        b.classList.toggle("bg-white", active);
        b.classList.toggle("shadow-sm", active);
      });

      renderTable();
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    loadRsvps();
  });
</script>

